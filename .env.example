# ===================================================
# Utah Wildfire & Wind Tracker Configuration (Example)
# ===================================================
# Copy this file to '.env' in the root directory to customize your deployment.

# 1. CORS Allowed Origins (Backend Protection)
# To secure a production deployment, replace '*' with your domain (e.g. 'https://utfires.example.com').
# You can supply a comma-separated list of multiple domains if needed.
ALLOWED_ORIGINS=*

# 2. Production Domain (Nginx Server Name)
# This binds Nginx to serve requests matching this domain name.
# To serve catch-all wildcard traffic, use '_'.
PRODUCTION_DOMAIN=_

# 3. Map Tile Configuration
# API Key for carto.com tile layers (optional but prevents prompt/limits)
CARTO_API_KEY=

