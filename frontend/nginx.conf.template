# Define rate limit zone for API requests (10MB memory zone, 5 requests/sec)
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=5r/s;

# Separate, generous zone for tile proxy requests so map tile traffic
# cannot consume the API rate-limit bucket (which would starve /api feeds).
limit_req_zone $binary_remote_addr zone=tiles_limit:10m rate=10r/s;

# Resolver for the dynamic downstream proxy_pass host ($2.basemaps.cartocdn.com).
resolver 8.8.8.8 1.1.1.1 valid=30s ipv6=off;

server {
    listen 80;
    server_name ${PRODUCTION_DOMAIN};

    # Enable gzip for text/json/JS/CSS assets and proxied API responses.
    # The 1.9MB burn-perimeters GeoJSON drops ~3x (662KB) with this alone.
    gzip on;
    gzip_types application/json application/javascript text/plain text/css text/javascript application/xml;
    gzip_min_length 256;
    gzip_vary on;
    gzip_proxied any;

    # Carto API key (injected server-side by envsubst at container startup).
    # The key never leaves the server: it is added to the tile request only here.
    set $carto_api_key "${CARTO_API_KEY}";
    set $carto_query "";
    if ($carto_api_key != "") {
        set $carto_query "?key=$carto_api_key";
    }

    # HTTP Security Headers
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://*.tile.openstreetmap.org https://*.basemaps.cartocdn.com https://unpkg.com https://services3.arcgis.com https://services2.arcgis.com https://services9.arcgis.com; connect-src 'self' https://nominatim.openstreetmap.org;" always;

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
    }

    # API Proxy with Rate Limiting (burst up to 10 requests, no delay)
    location /api {
        limit_req zone=api_limit burst=10 nodelay;
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Carto basemap tile proxy. The browser requests /tiles/{theme}/{s}/{z}/{x}/{y}(@2x).png
    # and nginx proxies it upstream, attaching the API key from $carto_api_key.
    # This keeps the key out of the client, DevTools, browser history, and logs.
    location ~ ^/tiles/(dark_all|light_all)/([a-d])/(\d+)/(\d+)/(\d+)(@2x)?\.png$ {
        limit_req zone=tiles_limit burst=60 nodelay;
        proxy_pass https://$2.basemaps.cartocdn.com/$1/$3/$4/$5$6.png$carto_query;
        proxy_set_header Host $2.basemaps.cartocdn.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
